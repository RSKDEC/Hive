# --- Online play (Supabase) -------------------------------------------------------------
# From Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public "anon" key: used by browsers only to subscribe to realtime notifications.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Secret "service_role" key: server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: extra secret mixed into stored player-token hashes.
PLAYER_SECRET_PEPPER=change-me-to-a-long-random-string

# --- Without Supabase ---------------------------------------------------------------------
# Online games are kept in server memory during `npm run dev`. To allow that in a production
# build on a single machine (not on Vercel), set:
# ALLOW_MEMORY_STORE=1
